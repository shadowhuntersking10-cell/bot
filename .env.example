# ============================================================
# VYRON — environment configuration (placeholders ONLY)
# On first `python main.py` this file is copied to .env automatically
# (with a random SESSION_SECRET). NEVER commit .env.
# Most keys can also be edited later in Admin → Integrations.
# ============================================================

# ---- Core ----
APP_ENV=production
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000
# Public HTTPS address of this server (required for Telegram Web App + callbacks)
PUBLIC_BASE_URL=https://your-domain.example
WEBAPP_URL=
SESSION_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- MySQL (dedicated user, NOT root — see deploy/mysql_setup.sql) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vyron
DB_USER=vyron_app
DB_PASSWORD=
# Alternatively a full SQLAlchemy URL (overrides DB_*):
# DATABASE_URL=mysql+pymysql://vyron_app:password@127.0.0.1:3306/vyron?charset=utf8mb4
# Local development only: fall back to runtime/dev.sqlite3 when MySQL is unreachable
DATABASE_FALLBACK_SQLITE=false

# ---- First website admin (created/updated on start; optional) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs that get the admin panel
TELEGRAM_ADMIN_IDS=

# ---- Payerpin (supplier / fulfillment) ----
PAYERPIN_API_KEY=
PAYERPIN_BASE_URL=https://api.payerpin.uz
PAYERPIN_WEBHOOK_SECRET=

# ---- Hamyon API (automatic HUMO/UZCARD payments → wallet top-up) ----
# shop_id / shop_key from @HamyonAPIBot. In the shop settings set:
#   complete_url = {PUBLIC_BASE_URL}/api/webhooks/hamyon/complete
#   prepare_url  = {PUBLIC_BASE_URL}/api/webhooks/hamyon/prepare
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=
HAMYON_BASE_URL=https://hamyon-api.uz

# ---- Optional: generic signed-webhook payment provider for direct order payment ----
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=UZS

# ---- Workers ----
FULFILLMENT_WORKER_ENABLED=true
FULFILLMENT_POLL_SECONDS=5
CATALOG_SYNC_INTERVAL_MINUTES=60
RATE_LIMIT_ENABLED=true
# Extra origins allowed to call the API cross-site (normally empty)
CORS_ORIGINS=
